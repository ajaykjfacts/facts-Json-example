[
    {
        "exec": "validatedataset",
        "verify": {
            "satisfy": "any",
            "halton": "match",
            "ref": {
                "[DsFrmHeaderEntry.TSF_DIVN_DOCNO(ifnull)raw.]": ""
            },
            "whenmatch": [
                {
                    "exec": "setdataset",
                    "args": {
                        "dset": "snackinfo",
                        "data": {
                            "open": true,
                            "type": "error",
                            "message": "Please select the Division"
                        }
                    }
                }
            ]
        }
    },
    {
        "exec": "validatedataset",
        "verify": {
            "satisfy": "any",
            "halton": "match",
            "ref": {
                "[DsFrmHeaderEntry.TSF_SMAN_DOCNO(ifnull)raw.]": ""
            },
            "whenmatch": [
                {
                    "exec": "setdataset",
                    "args": {
                        "dset": "snackinfo",
                        "data": {
                            "open": true,
                            "type": "error",
                            "message": "Please select the Staff"
                        }
                    }
                }
            ]
        }
    },







    {
        "exec": "mergedatasetarray",
        "args": {
            "dset": "DsFrmDetails1",
            "mode": "updatecol",
            "data": {
                "row_error": "",
                "row_error_message": ""
            }
        }
    },
    {
        "exec": "forLoop",
        "args": {
            "dset": "DsFrmDetails1",
            "perform": [
                {
                    "exec": "validatedataset",
                    "verify": {
                        "satisfy": "any",
                        "ref": {
                            "[this.TSFDET_STOCK_DOCNO(eq)raw.1]": true,
                            "[this.TSFDET_STOCK_DOCNO(ifnull)raw.]": ""
                        },
                        "whenmatch": [
                            {
                                "exec": "mergedatasetarray",
                                "args": {
                                    "dset": "DsFrmDetails1",
                                    "index": "[this.propkey]",
                                    "data": {
                                        "row_error": "error",
                                        "row_error_message": "Please select the Stock Code;"
                                    }
                                }
                            }
                        ]
                    }
                },
                {
                    "exec": "validatedataset",
                    "verify": {
                        "satisfy": "any",
                        "ref": {
                            "[this.TSFDET_QTY(ifnull)raw.]": "",
                            "[this.TSFDET_QTY(eq)raw.1]": 0
                        },
                        "whenmatch": [
                            {
                                "exec": "mergedatasetarray",
                                "args": {
                                    "dset": "DsFrmDetails1",
                                    "index": "[this.propkey]",
                                    "data": {
                                        "row_error": "error",
                                        "row_error_message": "[raw. [DsFrmDetails1.[this.propkey].row_error_message] Quantity cannot be zero;]"
                                    }
                                }
                            }
                        ]
                    }
                }
            ]
        }
    },
    {
        "exec": "mergedataset",
        "args": {
            "dset": "DsFrmHeaderEntry",
            "data": {
                "errorRowCount": "[DsFrmDetails1(listfilter)raw.row_error=>error(listcount)]"
            }
        }
    },
    {
        "exec": "validatedataset",
        "verify": {
            "satisfy": "any",
            "halton": "match",
            "ref": {
                "[DsFrmHeaderEntry.errorRowCount(>)raw.0]": true
            },
            "whenmatch": [
                {
                    "exec": "setdataset",
                    "args": {
                        "dset": "snackinfo",
                        "data": {
                            "open": true,
                            "type": "error",
                            "message": "Please fill in all required fields"
                        }
                    }
                }
            ]
        }
    }
    
]