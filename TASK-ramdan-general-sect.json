[
    {
        "type": "sect",
        "props": {
            "container": true,
            "resolvestyles": true,
            "appendprops": {
                "style": {
                    "pointerEvents": "[dsPagemode.pagemode(eq)raw.view(iftrue)raw.none(iffalse)raw.all]"
                }
            }
        },
        "chld": [
            {
                "type": "sect",
                "props": {
                    "container": true,
                    "style": {
                        "display": "block"
                    }
                },
                "chld": [
                    {
                        "type": "sect",
                        "props": {
                            "item": true,
                            "md": 4,
                            "xs": 4,
                            "className": "factsFullWidth",
                            "style": {
                                "textAlignLast": "left",
                                "padding": "5px"
                            }
                        },
                        "chld": [
                            {
                                "type": "div",
                                "props": {
                                    "className": "entryLabelOuterDiv"
                                },
                                "chld": [
                                    {
                                        "type": "div",
                                        "props": {
                                            "className": "entryLabelDiv"
                                        },
                                        "chld": [
                                            {
                                                "type": "lbl",
                                                "props": {
                                                    "text": "Doc#",
                                                    "className": "entryLabel"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "div",
                                        "props": {
                                            "className": "entryValueDiv"
                                        },
                                        "chld": [
                                            {
                                                "type": "entry",
                                                "props": {
                                                    "label": "",
                                                    "fullWidth": true,
                                                    "className": "small-ctr",
                                                    "inputVariant": "outlined",
                                                    "inputProps": {
                                                        "maxLength": 20,
                                                        "style": {
                                                            "width": "200px"
                                                        }
                                                    },
                                                    "dset": "DsFrmHeaderEntry",
                                                    "bind": "RMP_DOCNO"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "sect",
                        "props": {
                            "item": true,
                            "xs": 12,
                            "style": {
                                "textAlignLast": "left"
                            }
                        },
                        "chld": []
                    },
                    {
                        "type": "sect",
                        "props": {
                            "item": true,
                            "md": 4,
                            "xs": 8,
                            "className": "factsFullWidth",
                            "style": {
                                "textAlignLast": "left",
                                "padding": "5px"
                            }
                        },
                        "chld": [
                            {
                                "type": "div",
                                "props": {
                                    "className": "entryLabelOuterDiv"
                                },
                                "chld": [
                                    {
                                        "type": "div",
                                        "props": {
                                            "className": "entryLabelDiv"
                                        },
                                        "chld": [
                                            {
                                                "type": "lbl",
                                                "props": {
                                                    "text": "Starting Date",
                                                    "className": "entryLabel"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "div",
                                        "props": {
                                            "className": "entryValueDiv"
                                        },
                                        "chld": [
                                            {
                                                "type": "dtpick",
                                                "props": {
                                                    "label": "",
                                                    "fullWidth": true,
                                                    "inputVariant": "outlined",
                                                    "inputProps": {
                                                        "style": {
                                                            "paddingTop": "7px",
                                                            "paddingBottom": "7px",
                                                            "fontSize": "0.8rem"
                                                        }
                                                    },
                                                    "dset": "DsFrmHeaderEntry",
                                                    "bind": "RMP_FROMDATE",
                                                    "whenchange": [
                                                        {
                                                            "exec": "filldataset",
                                                            "args": {
                                                                "proc": "PWA.RMP_Onchange",
                                                                "row": 0,
                                                                "dset": "DsFrmDateONchange",
                                                                "args": {
                                                                    "RMP_FROMDATE": "[DsFrmHeaderEntry.RMP_FROMDATE]",
                                                                    "RMP_TODATE": "[DsFrmHeaderEntry.RMP_TODATE]",
                                                                    "changefield": "date"
                                                                }
                                                            }
                                                        },
                                                        {
                                                            "exec": "mergedataset",
                                                            "args": {
                                                                "dset": "DsFrmHeaderEntry",
                                                                "data": {
                                                                    "RMP_FROMDATE": "[DsFrmDateONchange.RMP_FROMDATE]",
                                                                    "RMP_TODATE": "[DsFrmDateONchange.RMP_TODATE]",
                                                                    "RMP_DAYS": "[DsFrmDateONchange.RMP_DAYS]"
                                                                }
                                                            }
                                                        }
                                                    ]
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "sect",
                        "props": {
                            "item": true,
                            "xs": 12,
                            "style": {
                                "textAlignLast": "left"
                            }
                        },
                        "chld": []
                    },
                    {
                        "type": "sect",
                        "props": {
                            "item": true,
                            "md": 4,
                            "xs": 8,
                            "className": "factsFullWidth",
                            "style": {
                                "textAlignLast": "left",
                                "padding": "5px"
                            }
                        },
                        "chld": [
                            {
                                "type": "div",
                                "props": {
                                    "className": "entryLabelOuterDiv"
                                },
                                "chld": [
                                    {
                                        "type": "div",
                                        "props": {
                                            "className": "entryLabelDiv"
                                        },
                                        "chld": [
                                            {
                                                "type": "lbl",
                                                "props": {
                                                    "text": "End Date",
                                                    "className": "entryLabel"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "div",
                                        "props": {
                                            "className": "entryValueDiv"
                                        },
                                        "chld": [
                                            {
                                                "type": "dtpick",
                                                "props": {
                                                    "label": "",
                                                    "fullWidth": true,
                                                    "inputVariant": "outlined",
                                                    "inputProps": {
                                                        "style": {
                                                            "paddingTop": "7px",
                                                            "paddingBottom": "7px",
                                                            "fontSize": "0.8rem"
                                                        }
                                                    },
                                                    "dset": "DsFrmHeaderEntry",
                                                    "bind": "RMP_TODATE",
                                                    "whenchange": [
                                                        {
                                                            "exec": "filldataset",
                                                            "args": {
                                                                "proc": "PWA.RMP_Onchange",
                                                                "row": 0,
                                                                "dset": "DsFrmDateONchange",
                                                                "args": {
                                                                    "RMP_FROMDATE": "[DsFrmHeaderEntry.RMP_FROMDATE]",
                                                                    "RMP_TODATE": "[DsFrmHeaderEntry.RMP_TODATE]",
                                                                    "changefield": "date"
                                                                }
                                                            }
                                                        },
                                                        {
                                                            "exec": "mergedataset",
                                                            "args": {
                                                                "dset": "DsFrmHeaderEntry",
                                                                "data": {
                                                                    "RMP_FROMDATE": "[DsFrmDateONchange.RMP_FROMDATE]",
                                                                    "RMP_TODATE": "[DsFrmDateONchange.RMP_TODATE]",
                                                                    "RMP_DAYS": "[DsFrmDateONchange.RMP_DAYS]"
                                                                }
                                                            }
                                                        }
                                                    ]
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "sect",
                        "props": {
                            "item": true,
                            "xs": 12,
                            "style": {
                                "textAlignLast": "left"
                            }
                        },
                        "chld": []
                    },
                    {
                        "type": "sect",
                        "props": {
                            "item": true,
                            "md": 4,
                            "xs": 8,
                            "className": "factsFullWidth",
                            "style": {
                                "padding": "5px"
                            }
                        },
                        "chld": [
                            {
                                "type": "div",
                                "props": {
                                    "className": "entryLabelOuterDiv"
                                },
                                "chld": [
                                    {
                                        "type": "div",
                                        "props": {
                                            "className": "entryLabelDiv"
                                        },
                                        "chld": [
                                            {
                                                "type": "lbl",
                                                "props": {
                                                    "text": "Number of Days",
                                                    "className": "entryLabel"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "div",
                                        "props": {
                                            "className": "entryValueDiv"
                                        },
                                        "chld": [
                                            {
                                                "type": "dxnumberbox",
                                                "props": {
                                                    "dset": "DsFrmHeaderEntry",
                                                    "label": "",
                                                    "disabled": true,
                                                    "fullWidth": true,
                                                    "format": "##,###.00",
                                                    "style": {},
                                                    "inputProps": {
                                                        "maxLength": 5,
                                                        "style": {
                                                            "fontWeight": "bold",
                                                            "textAlign": "right",
                                                            "height": "11px"
                                                        }
                                                    },
                                                    "className": "small-ctr",
                                                    "variant": "outlined",
                                                    "includerefdata": true,
                                                    "bind": "RMP_DAYS",
                                                    "onFocusOut": [
                                                        {
                                                            "exec": "filldataset",
                                                            "args": {
                                                                "proc": "PWA.RMP_Onchange",
                                                                "row": 0,
                                                                "dset": "DsFrmDateONchange",
                                                                "args": {
                                                                    "RMP_FROMDATE": "[DsFrmHeaderEntry.RMP_FROMDATE(dtformat)raw.yyyy-MM-dd]",
                                                                    "RMP_TODATE": "[DsFrmHeaderEntry.RMP_TODATE(dtformat)raw.yyyy-MM-dd]",
                                                                    "changefield": "days"
                                                                }
                                                            }
                                                        },
                                                        {
                                                            "exec": "mergedataset",
                                                            "args": {
                                                                "dset": "DsFrmHeaderEntry",
                                                                "data": {
                                                                    "RMP_FROMDATE": "[DsFrmDateONchange.RMP_FROMDATE]",
                                                                    "RMP_TODATE": "[DsFrmDateONchange.RMP_TODATE]",
                                                                    "RMP_DAYS": "[DsFrmDateONchange.RMP_DAYS]"
                                                                }
                                                            }
                                                        }
                                                    ]
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "sect",
                        "props": {
                            "item": true,
                            "xs": 12,
                            "style": {
                                "textAlignLast": "left"
                            }
                        },
                        "chld": []
                    },
                    {
                        "type": "hide",
                        "props": {
                            "resolveprops": true,
                            "xsUp": true
                        },
                        "chld": [
                            {
                                "type": "sect",
                                "props": {
                                    "item": true,
                                    "xs": 6,
                                    "className": "subHeadingLbl",
                                    "style": {
                                        "textAlignLast": "left",
                                        "padding": "5px"
                                    }
                                },
                                "chld": [
                                    {
                                        "type": "lbl",
                                        "props": {
                                            "text": "To",
                                            "fullWidth": true
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "sect",
                        "props": {
                            "item": true,
                            "xs": 12,
                            "style": {
                                "textAlignLast": "left"
                            }
                        },
                        "chld": []
                    },
                    {
                        "type": "sect",
                        "props": {
                            "item": true,
                            "xs": 12,
                            "md": 6,
                            "className": "factsFullWidth",
                            "style": {
                                "textAlignLast": "left",
                                "padding": "5px"
                            }
                        },
                        "chld": [
                            {
                                "type": "div",
                                "props": {
                                    "className": "entryLabelOuterDiv"
                                },
                                "chld": [
                                    {
                                        "type": "div",
                                        "props": {
                                            "className": "entryLabelDiv"
                                        },
                                        "chld": [
                                            {
                                                "type": "lbl",
                                                "props": {
                                                    "text": "Remarks *",
                                                    "className": "entryLabel"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "div",
                                        "props": {
                                            "className": "entryValueDiv"
                                        },
                                        "chld": [
                                            {
                                                "type": "entry",
                                                "props": {
                                                    "label": "",
                                                    "fullWidth": true,
                                                    "required": true,
                                                    "validation": {
                                              "for": "text",
                                              "msg": "Please enter the Remarks",
                                              "validationParams": {
                                                "minLength": 1
                                              }
                                            },
                                                    "className": "small-ctr",
                                                    "inputVariant": "outlined",
                                                    "inputProps": {
                                                        "maxLength": 250
                                                    },
                                                    "dset": "DsFrmHeaderEntry",
                                                    "bind": "RMP_REMARKS"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "sect",
                        "props": {
                            "item": true,
                            "xs": 12,
                            "style": {
                                "textAlignLast": "left"
                            }
                        },
                        "chld": []
                    }
                ]
            }
        ]
    }
]