            "data": {
                "ACOPNDET_AC_DOCNO": "[DsFrmHeaderEntry.ACOPN_AC_DOCNO]",
                "ACOPNDET_SUBLEDGER_DOCNO": "[DsFrmHeaderEntry.ACOPN_SUBLEDGER_DOCNO]",
                "ACOPNDET_DEPT_DOCNO": "[DsFrmHeaderEntry.ACOPN_DEPT_DOCNO]",
                "ACOPNDET_DIVN_DOCNO": "[DsFrmHeaderEntry.ACOPN_DIVN_DOCNO]"
