[
    {
        "exec": "validatedataset",
        "verify": {
            "satisfy": "any",
            "halton": "match",
            "ref": {
                "[DsFrmHeaderEntry.ACOPN_AC_DOCNO(ifnull)raw.]": ""
            },
            "whenmatch": [
                {
                    "exec": "setdataset",
                    "args": {
                        "dset": "snackinfo",
                        "data": {
                            "open": true,
                            "type": "error",
                            "message": "Please select the GL Code"
                        }
                    }
                }
            ]
        }
    },
    {
        "exec": "validatedataset",
        "verify": {
            "satisfy": "any",
            "halton": "match",
            "ref": {
                "[DsFrmHeaderEntry.ACOPN_SUBLEDGER_DOCNO(ifnull)raw.]": ""
            },
            "whenmatch": [
                {
                    "exec": "setdataset",
                    "args": {
                        "dset": "snackinfo",
                        "data": {
                            "open": true,
                            "type": "error",
                            "message": "Please select the SL Code"
                        }
                    }
                }
            ]
        }
    },
    {
        "exec": "validatedataset",
        "verify": {
            "satisfy": "all",
            "halton": "match",
            "ref": {
                "[DsFrmHeaderEntry.ACOPN_SUBLEDGER_REQUIRED(eq)raw.1]": true,
                "[DsFrmHeaderEntry.ACOPN_SUBLEDGER_DOCNO(ifnull)raw.]": ""
            },
            "whenmatch": [
                {
                    "exec": "setdataset",
                    "args": {
                        "dset": "snackinfo",
                        "data": {
                            "open": true,
                            "type": "error",
                            "message": "Please select the SL Code."
                        }
                    }
                }
            ]
        }
    },
    {
        "exec": "mergedatasetarray",
        "args": {
            "dset": "DsFrmDetails1",
