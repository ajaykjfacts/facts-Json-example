    {
        "exec": "validatedataset",
        "verify": {
            "satisfy": "any",
            "ref": {
                "[dsPagemode.pagemode(neq)raw.New]": true
            },
            "whenmatch": [
                {
                    "exec": "setdataset",
                    "args": {
                        "dset": "DisableLookup",
                        "data": {
                            "disableStatus": true
                        }
                    }
                }
            ]
        }
    },
    {
        "exec": "setdataset",
