                    "variant": "contained"
                },
                "showFilterPanel": {
                    "xlDown": false
                },
                "DISABLE_LEFT": false,
                "DISABLE_RIGHT": false
            }
        }
    },
    {
        "exec": "setdataset",
        "args": {
            "dset": "EMPDetailsFilter",
            "data": {
