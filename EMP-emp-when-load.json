[
    {
        "exec": "filldataset",
        "args": {
            "proc": "PWA.GetSessionId",
            "row": 0,
            "dset": "dsSectionID",
            "args": {
                "strXmlHeader": "[DsFrmHeaderEntry]"
            }
        }
    },
    {
        "exec": "mergedataset",
        "args": {
            "dset": "DsFrmHeaderEntry",
            "data": "[dsSectionID]"
        }
    },
    {
        "exec": "setdataset",
        "args": {
            "dset": "EmpTabFilterOptions",
