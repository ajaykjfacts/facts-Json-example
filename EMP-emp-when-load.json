                    "className": "btnGrpContained"
                },
                "btnAddress": {
                    "className": "btnGrpInherit"
                },
                "btnEducation": {
                    "className": "btnGrpInherit"
                },
                "btnExperience": {
                    "className": "btnGrpInherit"
                },
                "btnDocuments": {
                    "className": "btnGrpInherit"
                },
                "btnFamily": {
                    "className": "btnGrpInherit"
                },
                "btnCompensation": {
                    "className": "btnGrpInherit"
                },
                "btnProvision": {
                    "className": "btnGrpInherit"
                },
                "btnLeave": {
                    "className": "btnGrpInherit"
