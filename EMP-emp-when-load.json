                },
                "showFilterPanel": {
                    "xlDown": false
                },
                "DISABLE_LEFT": false,
                "DISABLE_RIGHT": false
            }
        }
    },
    {
        "exec": "fillmultidataset",
        "args": {
            "proc": "PWA.Emp_Master_ddldetails",
            "dsets": [
                {
                    "name": "dsGender",
                    "table": "Table"
                },
                {
                    "name": "dsMarital",
                    "table": "Table1"
                },
                {
                    "name": "dsBloodGroup",
                    "table": "Table2"
                }
            ],
            "args": {
                "doctype": "dblr",
                "docno": "LR16"
            }
        }
    },
    {
        "exec": "setdatasetfield",
        "args": {
            "dset": "DsFrmPhoto",
            "fieldname": "filecontent",
            "data": "[DsFrmHeaderEntry.photo]"
        }
    },
    {
        "exec": "mergedataset",
        "args": {
            "dset": "DsFrmHeaderEntry",
            "data": {
                "timeattendance": 0,
                "EMPMST_NORMAL_OT_PERCENTAGE": 0,
                "overtimepercentage": 1,
                "otheroption": 1
            }
        }
    },
