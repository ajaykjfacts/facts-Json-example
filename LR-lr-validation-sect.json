[
    {
        "exec": "mergedatasetarray",
        "args": {
            "dset": "DsFrmDetails1",
            "mode": "updatecol",
            "data": {
                "row_error": "",
                "row_error_message": ""
            }
        }
    },
    {
        "exec": "forLoop",
        "args": {
            "dset": "DsFrmDetails1",
            "perform": [
                {
                    "exec": "validatedataset",
                    "verify": {
                        "satisfy": "any",
                        "ref": {
                            "[this.LDET_TYPE_DOCNO(ifnull)raw.(eq)raw.]": true
                        },
                        "whenmatch": [
                            {
                                "exec": "mergedatasetarray",
                                "args": {
                                    "dset": "DsFrmDetails1",
                                    "index": "[this.propkey]",
                                    "data": {
                                        "row_error": "error",
                                        "row_error_message": "Please select Leave Type;"
                                    }
                                }
                            }
                        ]
                    }
                },
                {
                    "exec": "validatedataset",
                    "verify": {
                        "satisfy": "any",
                        "ref": {
                            "[this.LDET_LEAVE_DAYS(ifnull)raw.0(eq)raw.0]": true
                        },
                        "whenmatch": [
                            {
                                "exec": "mergedatasetarray",
                                "args": {
                                    "dset": "DsFrmDetails1",
                                    "index": "[this.propkey]",
                                    "data": {
                                        "row_error": "error",
                                        "row_error_message": "[raw. [DsFrmDetails1.[this.propkey].row_error_message] Please enter the leave days;]"
                                    }
                                }
                            }
                        ]
                    }
                }
            ]
        }
    },
    {
        "exec": "mergedataset",
        "args": {
            "dset": "DsFrmHeaderEntry",
            "data": {
                "errorRowCount": "[DsFrmDetails1(listfilter)raw.row_error=>error(listcount)]"
            }
        }
    },
    {
        "exec": "validatedataset",
        "verify": {
            "satisfy": "any",
            "halton": "match",
            "ref": {
                "[DsFrmHeaderEntry.errorRowCount(>)raw.0]": true
            },
            "whenmatch": [
                {
                    "exec": "setdataset",
                    "args": {
                        "dset": "snackinfo",
                        "data": {
                            "open": true,
                            "type": "error",
                            "message": "Please fill in all required fields"
                        }
                    }
                }
            ]
        }
    },

    {
        "exec": "mergedataset",
        "args": {
            "dset": "DsFrmHeaderEntry",
            "data": {
                "DetailsTotalLeave": "[DsFrmDetails1(listsum)raw.LDET_LEAVE_DAYS]"
            }
        }
    },
    {
        "exec": "validatedataset",
        "verify": {
            "satisfy": "any",
            "halton": "match",
            "ref": {
                "[DsFrmHeaderEntry.DetailsTotalLeave(-)DsFrmHeaderEntry.LH_TOTAL_LEAVE_DAYS_APPLIED(neq)raw.0]": true
            },
            "whenmatch": [
                {
                    "exec": "setdataset",
                    "args": {
                        "dset": "snackinfo",
                        "data": {
                            "open": true,
                            "type": "error",
                            "message": "Total Leave days are not matching"
                        }
                    }
                }
            ]
        }
    }
]